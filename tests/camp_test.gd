extends SceneTree
var failures:=0
var checks:=0
var world
func _initialize() -> void: call_deferred("run")
func check(ok: bool,msg: String) -> void:
    checks+=1
    if not ok: failures+=1; push_error("FAIL: "+msg)
    else: print("PASS: "+msg)
func frames(n: int) -> void:
    for i in n: await physics_frame
func run() -> void:
    world=load("res://scenes/camp.tscn").instantiate()
    root.add_child(world)
    await frames(3)
    world.set_process(false)
    world.player.position=Vector2(450,520)
    var start: Vector2=world.player.position
    Input.action_press("move_right"); await frames(30); Input.action_release("move_right")
    check(world.player.position.x>start.x+65,"movement advances at intended speed")
    world.state.add_object("tree",Vector2(470,600),"test_tree")
    world.player.position=Vector2(470,660)
    world.player.attack(Vector2.UP)
    await frames(15)
    check(world.state.objects.test_tree.hp==100,"attack does not damage during windup")
    await frames(15)
    check(world.state.objects.test_tree.hp==75,"contact frame damages target once")
    await frames(23)
    check(world.state.objects.test_tree.hp==75,"recovery cannot repeat damage")
    world.player.position=Vector2(470,900)
    world.player_hit(Vector2.UP)
    check(world.state.objects.test_tree.hp==75,"out of range strike cannot harvest")
    world.state.damage("test_tree",75)
    world.player.position=Vector2(512,616)
    world.interact()
    check(world.state.timber==3 and world.collected==3,"one physical bundle awards three timber")
    world.interact()
    check(world.state.timber==3,"collected bundle cannot duplicate")
    world.state.timber=0; world.build_shed()
    check(world.built==0,"construction rejects missing materials")
    world.state.timber=6
    for i in 3: world.build_shed()
    world.sync_props()
    check(world.built==3 and world.state.timber==0 and world.buildings[2].integrity>0,"three construction stages consume six timber and produce building")
    world.state.damage("building_2_0",150)
    world.sync_props()
    await frames(3)
    check(world.buildings[2].body.get_child(0).disabled and not world.buildings[2].body.get_child(1).disabled,"destroyed building section opens only its own collision")
    world.add_modules(2)
    world.enter_room(1)
    check(world.room==1 and world.player.collision_mask==4 and not world.outdoors.visible,"entering switches floor and collision layer")
    world.leave_room()
    check(world.room==-1 and world.player.collision_mask==1 and world.player.position.distance_to(Vector2(930,425))<1,"leaving returns outside the same doorway")
    world.ore=3; world.state.timber=2; world.forge()
    check(not world.forged and world.ore==3,"forge cannot spend insufficient ore")
    world.ore=4; world.forge()
    check(world.forged and world.player.equipment=="iron" and world.ore==0 and world.state.timber==0,"forge spends once and equips visible iron kit")
    world.forge(); check(world.ore==0,"forging owned kit does not spend again")
    world.player.position=Vector2(1000,800)
    var e=world.enemies[0]
    e.actor.position=Vector2(1050,800)
    world.player_hit(Vector2.LEFT)
    check(e.hp==100,"facing away cannot damage enemy")
    world.player_hit(Vector2.RIGHT)
    check(e.hp==60,"upgraded axe damages one facing enemy")
    world.hp=100; world.player.invulnerable=0; world.enemy_hit(Vector2.LEFT,0)
    check(world.hp==88,"iron mitigates a valid enemy strike")
    world.player.dodge(Vector2.UP); world.enemy_hit(Vector2.LEFT,0)
    check(world.hp==88,"dodge invulnerability rejects incoming strike")
    world.player_hit(Vector2.RIGHT); world.player_hit(Vector2.RIGHT)
    check(world.kills==1 and e.hp==0 and e.actor.dead,"defeat awards resources and disables enemy")
    world.worker.position=Vector2(470,660)
    world.state.add_object("tree",Vector2(470,600),"worker_tree")
    world.worker_target="worker_tree"; world.worker_active=true
    for i in 7: world.worker_hit(Vector2.UP)
    check(world.worker_cargo==3 and world.state.objects.worker_tree_timber.state=="collected","worker removes physical bundle into cargo once")
    world.worker.position=Vector2(710,780); world.worker_tick(0.25)
    check(world.stored==3 and world.worker_cargo==0,"worker deposits actual cargo into store")
    world.hp=69; world.player.position=Vector2(680,580)
    check(world.save_game("user://camp_integration_test.json"),"campaign save writes")
    world.hp=5; world.ore=99; world.built=0
    check(world.load_game("user://camp_integration_test.json"),"campaign save restores")
    check(world.hp==69 and world.built==3 and world.stored==3 and world.kills==1 and world.forged,"progress equipment worker deposits and kills survive reload")
    check(world.state.objects.test_tree_timber.state=="collected","resource depletion survives reload")
    world.pause_menu()
    check(not world.player.is_physics_processing() and not world.enemies[1].actor.is_physics_processing(),"pause stops all actor attacks and movement")
    world.close_modal()
    world.queue_free(); await frames(3)
    print("CAMP CHECKS: %s; FAILURES: %s"%[checks,failures]); quit(1 if failures else 0)
