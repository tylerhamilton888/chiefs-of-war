extends SceneTree
const State = preload("res://scripts/world_state.gd")
var failures:=0
var checks:=0
func _initialize() -> void:
    call_deferred("run")
func check(condition: bool,message: String) -> void:
    checks+=1
    if condition:
        print("PASS: "+message)
    else:
        push_error("FAIL: "+message)
        failures+=1
func frames(count: int) -> void:
    for i in count:
        await physics_frame
func ticks(state: RefCounted,count: int) -> void:
    for i in count:
        state.fire_tick(0.25)
func run() -> void:
    var state:=State.new()
    state.add_object("tree",Vector2(200,200),"tree")
    state.damage("tree",25)
    check(state.objects.tree.hp==75,"tree retains partial damage")
    state.damage("tree",75)
    check(state.objects.tree.state=="felled","tree fells at zero health")
    check(state.objects.has("tree_timber"),"felling creates physical timber")
    state.damage("tree",100)
    check(state.objects.size()==2,"repeat damage cannot duplicate timber")
    check(state.collect("tree_timber"),"timber can be collected")
    check(not state.collect("tree_timber") and state.timber==1,"timber cannot be collected twice")
    state.add_object("wall",Vector2(600,300),"wall")
    state.add_object("roof",Vector2(650,300),"roof")
    state.damage("wall",150)
    check(state.objects.wall.state=="destroyed" and state.objects.roof.state=="intact","building parts have independent damage")
    state.set_terrain(Vector2i(5,5),"water")
    var restored:=State.new()
    check(restored.restore(state.snapshot()),"world snapshot loads")
    check(restored.objects.tree.state=="felled" and restored.objects.tree_timber.state=="collected","removed resources persist")
    check(restored.terrain_at(Vector2i(5,5))=="water","terrain edit persists")
    check(not restored.restore({"version":2,"objects":{"bad":{}},"terrain":{}}),"malformed save rejected")
    var fire:=State.new()
    fire.add_object("hearth",Vector2(200,200),"hearth")
    fire.add_object("tree",Vector2(220,200),"near_hearth")
    check(not fire.ignite("hearth","deliberate"),"contained hearth cannot ignite")
    ticks(fire,1000)
    check(not fire.objects.near_hearth.burning and fire.objects.near_hearth.hp==100,"contained hearth cannot spread or damage neighbors")
    fire.add_object("rock",Vector2(220,200),"rock")
    check(not fire.ignite("rock","raid"),"stone is nonflammable")
    check(not fire.ignite("near_hearth","accident"),"unapproved accidental ignition rejected")
    fire.add_object("tree",Vector2(280,200),"neighbor")
    check(fire.ignite("near_hearth","raid"),"explicit raid starts fire")
    ticks(fire,90)
    check(fire.objects.neighbor.burning,"nearby dry fuel heats and ignites")
    fire.extinguish("neighbor")
    check(not fire.objects.neighbor.burning and not fire.ignite("neighbor","raid"),"extinguish grants wet reignition protection")
    var barrier:=State.new()
    barrier.add_object("tree",Vector2(200,200),"a")
    barrier.add_object("tree",Vector2(280,200),"b")
    barrier.set_terrain(Vector2i(7,6),"earth")
    barrier.ignite("a","deliberate")
    ticks(barrier,90)
    check(not barrier.objects.b.burning,"earth firebreak blocks spread")
    barrier.set_terrain(Vector2i(7,6),"water")
    check(not barrier.clear_fire_path(Vector2(200,200),Vector2(280,200)),"water blocks spread")
    var paused:=State.new()
    paused.add_object("tree",Vector2(200,200),"a")
    paused.add_object("tree",Vector2(250,200),"b")
    paused.spread_enabled=false
    paused.ignite("a","deliberate")
    ticks(paused,100)
    check(not paused.objects.b.burning,"spread safety toggle works")
    check(paused.objects.a.hp<100,"spread toggle preserves local fire damage")
    var fire_save:=State.new()
    check(fire_save.restore(paused.snapshot()) and fire_save.objects.a.burning,"active fire persists through save")
    ticks(paused,100)
    check(paused.objects.a.state=="charred" and not paused.objects.a.burning,"burned object stops burning and becomes charred")
    var world=load("res://scenes/hearth.tscn").instantiate()
    root.add_child(world)
    await frames(4)
    world.player.position=Vector2(800,650)
    var start: Vector2=world.player.position
    Input.action_press("move_right")
    await frames(60)
    Input.action_release("move_right")
    var distance: float=world.player.position.distance_to(start)
    check(distance>130 and distance<160,"player movement near 145 px/sec")
    world.player.position=start
    Input.action_press("move_right")
    Input.action_press("move_down")
    await frames(60)
    Input.action_release("move_right")
    Input.action_release("move_down")
    check(absf(world.player.position.distance_to(start)-distance)<5,"diagonal movement normalized")
    world.player.position=Vector2(600,485)
    Input.action_press("move_up")
    await frames(40)
    Input.action_release("move_up")
    check(world.player.position.y>450,"independent wall blocks player")
    world.state.damage("hall_front_left",150)
    world.sync_props()
    await frames(3)
    Input.action_press("move_up")
    await frames(20)
    Input.action_release("move_up")
    check(world.player.position.y<430,"destroying wall opens traversable gap")
    world.state.set_terrain(Vector2i(28,20),"water")
    await frames(3)
    check(world.ground.water_bodies.has("28,20"),"water terrain creates collision")
    world.state.set_terrain(Vector2i(28,20),"earth")
    await frames(3)
    check(not world.ground.water_bodies.has("28,20"),"filling water removes collision")
    world.player.equip("iron")
    check(world.player.equipment=="iron" and "iron" in world.player.sprite.texture.resource_path,"equipment swaps whole-body visual set")
    world.player.position=Vector2(800,650)
    check(world.save_game("user://test_world.json"),"world save writes")
    world.player.position=Vector2(950,650)
    world.player.equip("leather")
    check(world.load_game("user://test_world.json"),"world save reloads")
    check(world.player.position.distance_to(Vector2(800,650))<1 and world.player.equipment=="iron","player position and equipment persist")
    check(world.state.objects.hall_front_left.state=="destroyed","destroyed building persists in integrated save")
    world.queue_free()
    await frames(3)
    print("CHECKS: %s; FAILURES: %s" % [checks,failures])
    quit(1 if failures else 0)
